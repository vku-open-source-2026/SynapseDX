        "operation": "workflows.list",
        "input": {}
      }
    },
    {
      "id": "325e2308-1c15-4f69-8360-4354f715fb87",
      "name": "ModelCore",
      "type": "synapseflow.model",
      "typeVersion": 1,
      "position": [
        1720,
        1360
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free"
      }
    }
  ],
