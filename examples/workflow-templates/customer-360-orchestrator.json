        "operation": "authorize.check",
        "input": {
          "userId": "={{ $json.userId }}",
          "action": "read",
          "resource": "customer360"
        }
      }
    },
    {
      "id": "bde0d85d-ec04-4486-8fa6-704667dff31d",
      "name": "FlowProbe",
      "type": "synapsedx.flow",
      "typeVersion": 1,
      "position": [
        1500,
        1360
      ],
