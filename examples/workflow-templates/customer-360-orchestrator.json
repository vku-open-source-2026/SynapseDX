{
  "name": "customer-360-orchestrator",
  "settings": {
    "onError": "continue",
    "timeoutMs": 300000
  },
  "nodes": [
    {
      "id": "a50084d3-f84a-4b94-8dbd-9e64ba8aa47f",
      "name": "Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        80,
        480
      ],
      "parameters": {
        "path": "customer-360-demo",
        "httpMethod": "POST"
      },
      "webhookId": "4f0a41c7-02e5-408c-8736-1de036f9709a"
    },
    {
      "id": "49c6c442-5638-41ad-92d6-a94a3f1b0d30",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        320,
        480
      ],
      "parameters": {
        "code": "const p = $input || {};const query = String(p.query || p.message || p.intent || \"customer health review\").trim();const amount = Number(p.amount || p.mrr || 0);const tier = String(p.tier || \"standard\");const urgent = /(urgent|asap|down|outage|production|critical)/i.test(query);const eventId = p.eventId || (\"evt-\" + Date.now());const customerId = p.customerId || \"demo-customer\";const riskScore = Math.min(100, Math.round(amount / 100 + (tier === \"enterprise\" ? 25 : 0) + (urgent ? 30 : 0)));return { ...p, query, amount, tier, customerId, eventId, priority: p.priority || (urgent ? \"urgent\" : \"normal\"), riskScore, receivedAt: $now };"
      }
    },
    {
      "id": "e47c2cc2-b38e-4c71-b8d7-88e2578050b0",
      "name": "Route",
      "type": "synapseflow.decision",
      "typeVersion": 1,
      "position": [
        580,
        480
      ],
      "parameters": {
        "input": "={{ $json.query }}",
        "choices": [
          {
            "name": "billing",
            "description": "billing, invoice, refund, charge, payment, subscription"
          },
          {
            "name": "technical",
            "description": "technical, error, outage, api, bug, incident, production"
          },
          {
            "name": "account",
            "description": "account, login, password, permission, access, user"
          },
          {
            "name": "growth",
            "description": "growth, upgrade, pricing, plan, renewal, expansion, sales"
          }
        ],
        "instruction": "Route this customer event to the team best equipped to handle it.",
        "fallbackBranch": 3,
        "minConfidence": 0.25
      }
    },
    {
      "id": "081652b8-0472-41c6-b147-076a44d38537",
      "name": "FlowCatalog",
      "type": "synapsedx.flow",
      "typeVersion": 1,
      "position": [
        840,
        40
      ],
      "parameters": {
        "operation": "workflows.list",
        "input": {}
      }
    },
    {
      "id": "8645594d-5289-449b-81cb-ac8ae83deaf8",
      "name": "HasLDS",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        840,
        200
      ],
      "parameters": {
        "condition": "={{ !!$json.datasourceId }}"
      }
    },
    {
      "id": "d3d84269-67b0-4d7c-881f-64c807d805f2",
      "name": "PublishTimeline",
      "type": "synapsedx.lds",
      "typeVersion": 1,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "operation": "publish-record",
        "input": {
          "datasourceId": "={{ $json.datasourceId }}",
          "record": {
            "id": "={{ $json.eventId }}",
            "eventId": "={{ $json.eventId }}",
            "kind": "customer360.event",
            "customerId": "={{ $json.customerId }}",
            "route": "pending",
            "query": "={{ $json.query }}",
            "amount": "={{ $json.amount }}",
            "priority": "={{ $json.priority }}",
            "receivedAt": "={{ $json.receivedAt }}"
          }
        }
      }
    },
    {
      "id": "752abe81-5996-46cc-b6d2-019f20a584be",
      "name": "SkipLDS",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        260
      ],
      "parameters": {}
    },
    {
      "id": "40a06227-3e90-4f8a-ac0f-4f242e372658",
      "name": "BillingCalc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        840,
        380
      ],
      "parameters": {
        "code": "const amount = Number($input.amount || 0);const tier = String($input.tier || \"standard\");const discount = tier === \"enterprise\" ? 0.15 : tier === \"pro\" ? 0.08 : 0;const credit = Math.round(amount * discount * 100) / 100;return { ...$input, billing: { amount, credit, currency: \"USD\", tier, discount, decision: credit > 0 ? \"credit_approved\" : \"no_credit\", calculatedAt: $now } };"
      }
    },
    {
      "id": "331a25a0-a150-4c2a-a511-51ed73dffb81",
      "name": "BillingCache",
      "type": "synapsedx.faststore",
      "typeVersion": 1,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "operation": "set",
        "input": {
          "key": "billing:{{ $json.eventId }}",
          "value": "={{ $json.billing }}",
          "ttlSeconds": 3600
        }
      }
    },
    {
      "id": "08383c23-fa7b-431a-8ed6-0168ff824426",
      "name": "BillingRecord",
      "type": "synapsedx.base",
      "typeVersion": 1,
      "position": [
        1120,
        440
      ],
      "parameters": {
        "operation": "create-document",
        "input": {
          "collection": "customer360_events",
          "id": "={{ $json.eventId }}",
          "data": "={{ $json }}"
        }
      }
    },
    {
      "id": "920481d2-686d-447d-92a1-f9a0acb209c5",
      "name": "BillingDone",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1380,
        440
      ],
      "parameters": {
        "values": {
          "route": "billing",
          "branchResult": "={{ $json.data }}",
          "processedBy": "billing"
        }
      }
    },
    {
      "id": "6d08cc8d-5016-4557-85e4-52a4260432cc",
      "name": "IncidentAgent",
      "type": "synapseflow.aiAgent",
      "typeVersion": 1,
      "position": [
        840,
        620
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free",
        "systemPrompt": "You are the SRE commander in SynapseFlow. Diagnose incidents using the available tools. Prefer evidence from SynapseBase, Faststore, IAM and the workflow catalog. The audit collection is customer360_events. SynapseBase filters are JSON objects, for example {\"eventId\":\"evt-123\"}; never pass a SQL-style string or guess a collection name. Never invent status or customer data. Keep the final answer under 250 words and end with a one-paragraph customer-safe update.",
        "userPrompt": "Incident: \"{{ $json.query }}\". Event: {{ $json.eventId }}. Customer: {{ $json.customerId }}. Priority: {{ $json.priority }}. Route: {{ $json.decision.route }}. Use at most two tools, then return the remediation plan.",
        "tools": [
          "synapsebase_query",
          "synapsebase_vector_search",
          "faststore_cache",
          "iam_check_permission",
          "workflow_list"
        ],
        "maxSteps": 4,
        "maxTokens": 1024,
        "temperature": 0.1
      }
    },
    {
      "id": "cac71aa2-417d-4fd8-95eb-c06041d88880",
      "name": "AccountPrep",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        840,
        820
      ],
      "parameters": {}
    },
    {
      "id": "682cff32-0842-4e59-9e55-f292b0a4cfc0",
      "name": "AccountAuth",
      "type": "synapsedx.iam",
      "typeVersion": 1,
      "position": [
        1120,
        740
      ],
      "parameters": {
        "operation": "authorize.check",
        "input": {
          "userId": "={{ $json.userId }}",
          "action": "read",
          "resource": "customer360"
        }
      }
    },
    {
      "id": "625e6a48-975e-46f1-95ef-4aab66864ef4",
      "name": "AccountSnapshot",
      "type": "synapsedx.faststore",
      "typeVersion": 1,
      "position": [
        1120,
        840
      ],
      "parameters": {
        "operation": "hash-set",
        "input": {
          "key": "account:{{ $json.customerId }}",
          "values": {
            "tier": "={{ $json.tier }}",
            "riskScore": "={{ $json.riskScore }}",
            "lastRoute": "account",
            "checkedAt": "={{ $now }}"
          }
        }
      }
    },
    {
      "id": "425225ba-cf85-4d74-a27e-ef331d3c6f12",
      "name": "AccountRecord",
      "type": "synapsedx.base",
      "typeVersion": 1,
      "position": [
        1120,
        940
      ],
      "parameters": {
        "operation": "create-document",
        "input": {
          "collection": "customer360_events",
          "id": "={{ $json.eventId }}",
          "data": "={{ $json }}"
        }
      }
    },
    {
      "id": "e1f2ec51-61e2-4118-aa1a-72711e50f527",
      "name": "AccountDone",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1380,
        940
      ],
      "parameters": {
        "values": {
          "route": "account",
          "branchResult": "={{ $json.data }}",
          "processedBy": "account"
        }
      }
    },
    {
      "id": "5b935b2a-3705-4192-ad53-5d8c0323becc",
      "name": "GrowthPlan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        840,
        1080
      ],
      "parameters": {
        "code": "const amount = Number($input.amount || 0);const tier = String($input.tier || \"standard\");const plan = amount >= 5000 ? \"enterprise-expansion\" : amount > 0 ? \"growth-nurture\" : \"community\";return { ...$input, growth: { plan, tier, nextStep: plan === \"enterprise-expansion\" ? \"executive-business-review\" : \"self-serve-nurture\", createdAt: $now } };"
      }
    },
    {
      "id": "11825349-443d-4aee-a6a1-503bb0558c08",
      "name": "GrowthRecord",
      "type": "synapsedx.base",
      "typeVersion": 1,
      "position": [
        1120,
        1080
      ],
      "parameters": {
        "operation": "create-document",
        "input": {
          "collection": "customer360_events",
          "id": "={{ $json.eventId }}",
          "data": "={{ $json }}"
        }
      }
    },
    {
      "id": "1b9b2504-3363-4030-871c-2932f410ed9d",
      "name": "GrowthDone",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1380,
        1080
      ],
      "parameters": {
        "values": {
          "route": "growth",
          "branchResult": "={{ $json.data }}",
          "processedBy": "growth"
        }
      }
    },
    {
      "id": "9439e727-0de9-47c6-9c71-f70ce609b3b7",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1680,
        620
      ],
      "parameters": {
        "code": "const p = $input || {};const payload = p.branchResult || p;const d = p.decision || payload.decision || {};const route = p.route || payload.route || d.route || \"unknown\";const agent = p.agent || payload.agent || {};return { ...p, route, confidence: d.confidence ?? payload.confidence ?? p.confidence ?? 1, reply: p.response || agent.response || payload.reply || \"\", customerId: p.customerId || payload.customerId || \"demo-customer\", eventId: p.eventId || payload.eventId || (\"evt-\" + Date.now()), amount: Number(p.amount ?? payload.amount ?? 0), priority: p.priority || payload.priority || \"normal\", processedAt: $now };"
      }
    },
    {
      "id": "a7676a5c-c018-495d-84dd-321da659c03e",
      "name": "Metrics",
      "type": "synapsedx.faststore",
      "typeVersion": 1,
      "position": [
        1960,
        500
      ],
      "parameters": {
        "operation": "incr",
        "input": {
          "key": "customer360:processed",
          "by": 1
        }
      }
    },
    {
      "id": "3dc70d83-e90f-4283-84aa-e25a342693bd",
      "name": "RiskGate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1960,
        640
      ],
      "parameters": {
        "condition": "={{ ($json.confidence ?? 1) < 0.55 || $json.priority === \"urgent\" || ($json.amount ?? 0) >= 1000 }}"
      }
    },
    {
      "id": "5f0ce9be-1daf-4aba-b133-436d2f63c518",
      "name": "Escalate",
      "type": "synapsedx.queue",
      "typeVersion": 1,
      "position": [
        2240,
        560
      ],
      "parameters": {
        "operation": "publish",
        "input": {
          "queue": "customer360-escalations",
          "payload": "={{ $json }}",
          "priority": 8
        }
      }
    },
    {
      "id": "c651adcd-3c73-4dc2-8ded-75ad7a6c2e05",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2240,
        740
      ],
      "parameters": {}
    },
    {
      "id": "ee519fbc-f00e-4356-ab5b-7fb5799776f6",
