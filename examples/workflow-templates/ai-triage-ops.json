{
  "name": "ai-triage-ops",
  "settings": {
    "onError": "continue",
    "timeoutMs": 300000
  },
  "nodes": [
    {
      "id": "a5b5d629-0500-4a28-a179-5d418c3a4eda",
      "name": "Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        80,
        340
      ],
      "parameters": {
        "path": "ai-triage-demo",
        "httpMethod": "POST"
      }
    },
    {
      "id": "61e1b073-4d00-4214-a4d6-b9776a1b09d0",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        330,
        340
      ],
      "parameters": {
        "code": "const p = $input || {};const query = String(p.query || p.message || p.text || p.description || \"\").trim();const urgent = /(urgent|asap|down|outage|production)/i.test(query);return { ...p, query, ticketId: p.ticketId || (\"T-\" + Date.now()), priority: p.priority || (urgent ? \"urgent\" : \"normal\"), receivedAt: $now };"
      }
    },
    {
      "id": "ac9ad7da-3dda-4409-83f9-8a0bb1da4c92",
      "name": "Triage",
      "type": "synapseflow.decision",
      "typeVersion": 1,
      "position": [
        600,
        340
      ],
      "parameters": {
        "input": "={{ $json.query }}",
        "choices": [
          {
            "name": "billing",
            "description": "billing, invoices, refunds, payments, subscription charges"
          },
          {
            "name": "technical",
            "description": "bugs, errors, API failures, outages, technical problems"
          },
          {
            "name": "account",
            "description": "login, password, profile, permissions, account access"
          },
          {
            "name": "sales",
            "description": "pricing, plans, purchase, upgrade, partnership"
          }
        ],
        "instruction": "Route this support ticket to the team best equipped to handle it.",
        "fallbackBranch": 3,
        "minConfidence": 0.3
      }
    },
    {
      "id": "9a7423f8-0fe1-4237-8e1d-d306ed4c64f2",
      "name": "BillingAgent",
      "type": "synapseflow.aiAgent",
      "typeVersion": 1,
      "position": [
        900,
        80
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free",
        "systemPrompt": "You are the Billing specialist in SynapseFlow. Use SynapseBase and Faststore tools to ground every answer in real data. Be concise, cite amounts and invoice ids, and never invent a payment.",
        "userPrompt": "Handle this billing ticket. Customer says: \"{{ $json.query }}\". Ticket: {{ $json.ticketId }}. Look up the knowledge base/cache when useful, then produce the customer reply.",
        "tools": [
          "synapsebase_query",
          "faststore_cache",
          "decision_eval",
          "http_request",
          "workflow_run"
        ],
        "maxSteps": 7,
        "temperature": 0.2
      }
    },
    {
      "id": "a75532b7-4c87-4338-8e21-1e3448ddf887",
      "name": "TechAgent",
      "type": "synapseflow.aiAgent",
      "typeVersion": 1,
      "position": [
        900,
        320
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free",
        "systemPrompt": "You are the Technical support specialist in SynapseFlow. Diagnose the issue, use the code sandbox for calculations/transforms, and call the HTTP tool only for public status endpoints. Give concrete next steps.",
        "userPrompt": "Diagnose and answer this technical ticket: \"{{ $json.query }}\". Priority: {{ $json.priority }}. Use the KB/status tools, then produce the customer reply.",
        "tools": [
          "synapsebase_query",
          "code_sandbox",
          "logic_calculator",
          "decision_eval",
          "queue_publish",
          "http_request"
        ],
        "maxSteps": 8,
        "temperature": 0.2
      }
    },
    {
      "id": "f282f01a-e15e-4048-8c69-71aff04156ef",
      "name": "AccountAgent",
      "type": "synapseflow.aiAgent",
      "typeVersion": 1,
      "position": [
        900,
        560
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free",
        "systemPrompt": "You are the Account & Access specialist in SynapseFlow. Use the IAM permission check and cache tools before making claims about access. Never disclose secrets or other tenants' data.",
        "userPrompt": "Resolve this account/access ticket: \"{{ $json.query }}\". Customer id: {{ $json.customerId || \"unknown\" }}. Check permissions with tools, then produce the customer reply.",
        "tools": [
          "iam_check_permission",
          "faststore_cache",
          "workflow_list",
          "workflow_run"
        ],
        "maxSteps": 6,
        "temperature": 0.2
      }
    },
    {
      "id": "6984e735-cf86-432c-9175-19e455cedd91",
      "name": "SalesReply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        900,
        800
      ],
      "parameters": {
        "values": {
          "department": "sales",
          "reply": "Thanks for your interest in SynapseOne! Our sales team will reach out shortly with pricing and the right plan for your team."
        }
      }
    },
    {
      "id": "5f8feea1-37ca-402e-8b10-e5ca66a4c14e",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1240,
        340
      ],
      "parameters": {
        "code": "const d = $input.decision || {};const a = $input.agent || {};return { ...$input, route: d.route || $input.department || \"sales\", confidence: d.confidence ?? $input.confidence ?? 1, reply: a.response || $input.reply || \"\", department: d.route || $input.department || \"sales\", processedAt: $now };"
      }
    },
    {
      "id": "21724897-e7bb-43b8-97a4-7db61aabaffd",
      "name": "NeedsEscalation",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        340
      ],
      "parameters": {
        "condition": "={{ ($json.confidence ?? 1) < 0.55 || $json.priority === \"urgent\" }}"
      }
    },
    {
      "id": "076e6f02-a2c6-4116-ba1c-f9bc5516de05",
      "name": "Escalate",
      "type": "synapseone.queue",
      "typeVersion": 1,
      "position": [
        1780,
        220
      ],
      "parameters": {
        "operation": "publish",
        "input": {
          "queue": "support-escalations",
          "payload": "={{ $json }}",
          "priority": 5
        }
      }
    },
    {
      "id": "7825e5b2-f106-4325-9bc2-8d7dc3051ab0",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1780,
        460
      ],
      "parameters": {}
    },
    {
      "id": "8d46f67c-effb-48af-8e49-1d6066746a19",
      "name": "KBLookup",
      "type": "synapseone.base",
      "typeVersion": 1,
      "position": [
        620,
        980
      ],
      "parameters": {
        "operation": "query-documents",
        "input": {
          "collection": "support_kb",
          "limit": 5
        }
      }
    },
    {
      "id": "5a6af697-f7d8-445a-9d0e-39fcf43e9deb",
      "name": "CustomerCache",
      "type": "synapseone.faststore",
      "typeVersion": 1,
      "position": [
        620,
        1120
      ],
      "parameters": {
        "operation": "get",
        "input": {
          "key": "customer:={{ $json.customerId }}"
        }
      }
    },
    {
      "id": "7d4638f9-ed63-4706-8c56-8eab345432eb",
      "name": "PermissionCheck",
      "type": "synapseone.iam",
      "typeVersion": 1,
      "position": [
        620,
        1260
      ],
      "parameters": {
        "operation": "authorize.check",
        "input": {
          "userId": "={{ $json.userId }}",
          "action": "read",
          "resource": "support_ticket"
        }
      }
    },
    {
      "id": "ada97cf9-64ff-4c7b-9ce1-1a3604e69ef6",
      "name": "StatusAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        620,
        1400
      ],
      "parameters": {
        "url": "https://api.example.com/health",
        "method": "GET"
      }
    },
    {
      "id": "ccb2be43-77b2-4397-851b-49c3d9a8470c",
      "name": "ModelCore",
      "type": "synapseflow.model",
      "typeVersion": 1,
      "position": [
        620,
        1540
      ],
      "parameters": {
        "core": "synapse-inference",
        "model": "liquid/lfm-2.5-2.6b:free"
      }
    }
  ],
  "connections": {
    "Intake": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Triage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triage": {
      "main": [
        [
          {
            "node": "BillingAgent",
            "type": "main",
