{
  "name": "synapsedx",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "SynapseDX Tier-2 reusable capabilities product",
  "workspaces": ["apps/*", "sdks/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:service": "npm run build --workspace=@synapsedx/capabilities-service",
    "start:service": "npm run start --workspace=@synapsedx/capabilities-service",
    "build:sdk": "npm run build --workspace=@synapsedx/capabilities",
    "test:sdk": "npm run test --workspace=@synapsedx/capabilities"
  }
}
