{
  "name": "synapsedx",
  "version": "0.6.2",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "tools/*",
    "sdks/sdk-js"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "license-check": "node tools/license-check.cjs --sbom sbom.json",
    "dev:iam": "npm run dev --workspace=apps/iam-service",
    "dev:gateway": "npm run dev --workspace=apps/gateway",
    "dev:workflow": "npm run dev --workspace=apps/workflow-service",
    "dev:base": "npm run dev --workspace=apps/base-service",
    "dev:faststore": "npm run dev --workspace=apps/faststore-service",
    "dev:queue": "npm run dev --workspace=apps/queue-service",
    "dev:stream": "npm run dev --workspace=apps/stream-service",
    "dev:inference": "cd apps/inference-service && (.venv/bin/uvicorn src.main:app --port 4008 --reload || uvicorn src.main:app --port 4008 --reload)",
    "test:inference": "cd apps/inference-service && (.venv/bin/pytest tests || pytest tests)",
    "test:sdk-go": "docker run --rm -v $(pwd)/sdks/sdk-go:/sdk -w /sdk golang:1.22-alpine go test -v ./...",
    "test:e2e:go": "docker run --rm --network host -v $(pwd):/app -w /app/tests/e2e golang:1.22-alpine go run sdk-check.go",
    "test:e2e:inference": "node tests/e2e/inference-check.js"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
