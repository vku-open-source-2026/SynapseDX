NODE_ENV=production
PORT=8082
# Gateway -> backend route inside the Tier-2 product stack.
CAPABILITIES_SERVICE_URL=http://capabilities:8082
# Public Tier-1 gateway. Do not set this to a Docker service or localhost.
SYNAPSEONE_BASE_URL=https://api.synapseone.space
# Scoped service credential used for Tier-2's own Base/LDS/Queue/IAM access.
# It is never a fallback credential for anonymous callers.
SYNAPSEONE_API_KEY=
SYNAPSEONE_TOKEN=
# Used as the tenant context for platform-scoped Faststore/Queue operations.
SYNAPSEONE_TENANT=
# Queue + stream topic used for generic capability events.
SYNAPSEDX_EVENTS_QUEUE=synapsedx-capability-events
SYNAPSEDX_EVENTS_STREAM=synapsedx-capability-events
# "required" is the only production-safe mode; "optional" is test-only.
SYNAPSEDX_AUTH_MODE=required
# Comma-separated browser origins allowed by the service and gateway.
CORS_ORIGINS=https://synapsecity.sbs,https://sos.synapsecity.sbs,https://synapsedx.sbs,https://cloud.synapsedx.sbs
# Legacy single-origin alias (appended to CORS_ORIGINS when set).
CORS_ORIGIN=
# Idempotency replay window and per-request timeouts.
SYNAPSEDX_IDEMPOTENCY_ENABLED=true
SYNAPSEDX_IDEMPOTENCY_TTL_SECONDS=86400
SYNAPSEDX_REQUEST_TIMEOUT_MS=20000
SYNAPSEDX_MAX_PAGE_SIZE=500
SYNAPSEDX_AUDIT_ENABLED=true
# Bind every password/OIDC flow to one Tier-1 organization (recommended).
SYNAPSEDX_AUTH_ORG_SLUG=
# Default/allow-listed audiences for /v1/capabilities/auth/exchange.
SYNAPSEDX_AUTH_AUDIENCE=synapsedx
SYNAPSEDX_AUTH_ALLOWED_AUDIENCES=synapsedx,synapsecity,synapsecitysos
# File capability limits. Tier-1 storage enforces its own quota as well.
SYNAPSEDX_FILES_MAX_BYTES=26214400
SYNAPSEDX_FILES_QUOTA_BYTES=1073741824
SYNAPSEDX_FILES_ALLOWED_TYPES=
SYNAPSEDX_FILES_PRESIGN_TTL_SECONDS=900
SYNAPSEDX_FILES_PREFIX=synapsedx/files
# Optional licensed geocoder adapter (server-side key only).
# provider=vietmap uses maps.vietmap.vn/api and the `apikey` query parameter.
SYNAPSEDX_GEOCODER_PROVIDER=
SYNAPSEDX_GEOCODER_BASE_URL=
SYNAPSEDX_GEOCODER_API_KEY=
# Generic provider tuning (header or query key, endpoint paths).
SYNAPSEDX_GEOCODER_AUTH_HEADER=x-api-key
SYNAPSEDX_GEOCODER_AUTH_QUERY=
SYNAPSEDX_GEOCODER_AUTOCOMPLETE_PATH=
SYNAPSEDX_GEOCODER_GEOCODE_PATH=
SYNAPSEDX_GEOCODER_REVERSE_PATH=
SYNAPSEDX_GEOCODER_PLACE_PATH=
# Gateway upstream timeout.
UPSTREAM_TIMEOUT_MS=30000
# Only test processes may set this, never a production deployment.
ALLOW_LOCAL_DEPENDENCIES=false
