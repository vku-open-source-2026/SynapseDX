# ---- host ports (đổi khi chạy nhiều stack trên 1 máy) ----
GATEWAY_HOST_PORT=8080
IAM_HOST_PORT=4001
WORKFLOW_HOST_PORT=4002
N8N_HOST_PORT=5678
AUTHENTIK_HTTP_PORT=19000
AUTHENTIK_HTTPS_PORT=19443

# ---- core ----
POSTGRES_DB=olp
POSTGRES_USER=olp
POSTGRES_PASSWORD=olp_password_change_me
DATABASE_URL=postgres://olp:olp_password_change_me@postgres:5432/olp
REDIS_URL=redis://redis:6379

# ---- iam-service ----
IAM_PORT=4001
IAM_JWT_SECRET=change_me_super_secret_32chars_min
IAM_JWT_EXPIRES_IN=3600
IAM_REFRESH_EXPIRES_IN=2592000
# OIDC upstream (Authentik mặc định, có thể đổi sang Keycloak)
OIDC_ISSUER=http://authentik:9000/application/o/olp/
OIDC_CLIENT_ID=olp-platform
OIDC_CLIENT_SECRET=change_me_oidc_secret
OIDC_REDIRECT_URI=http://localhost:4001/v1/auth/oidc/callback

# ---- gateway ----
GATEWAY_PORT=8080
GATEWAY_ROUTES_PATH=./routes.yaml
IAM_SERVICE_URL=http://iam:4001
WORKFLOW_SERVICE_URL=http://workflow:4002
N8N_API_URL=http://n8n:5678/api/v1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- workflow-service ----
WORKFLOW_PORT=4002
N8N_API_KEY=change_me_n8n_api_key
N8N_BASE_URL=http://n8n:5678

# ---- minio (S3 tương thích, cụm dữ liệu lõi) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=olp-core

# ---- n8n ----
N8N_ENCRYPTION_KEY=change_me_n8n_32chars_key_1234567890
N8N_USER_MANAGEMENT_DISABLED=false
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# ---- authentik ----
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authentik_pw_change_me
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_SECRET_KEY=change_me_authentik_secret_key_60chars_min_xxxxxxxxxxxxxxxx
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ---- sdk / demo ----
DEMO_ORG_SLUG=acme
DEMO_ACCOUNT_SLUG=prod
