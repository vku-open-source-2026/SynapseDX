# SynapseDX env — copy sang .env roi doi moi gia tri *_change_me_*.
# Dev (localhost): giu default la chay. Prod (synapsedx.sbs): xem ghi chu PROD.

# ---- domains (PROD: synapsedx.sbs) ----
DOMAIN=synapsedx.sbs
LE_EMAIL=admin@example.com
# Canonical app (frontend chinh): PROD=https://cloud.synapsedx.sbs, dev=http://localhost:3000
CONSOLE_APP_URL=
# Web chinh/landing @: PROD=https://synapsedx.sbs (chi de hien thi/docs)
CONSOLE_LANDING_URL=

# ---- TLS terminator (docker-compose.tls.yml, dev) ----
TLS_HOST_PORT=8443

# ---- console (management UI) ----
CONSOLE_HOST_PORT=3000
# PROD: https://api.synapsedx.sbs
SYNAPSEDX_PUBLIC_BASE_URL=http://localhost:8080

# ---- host ports (doi khi chay nhieu stack tren 1 may) ----
# PROD: bind 127.0.0.1 (chi nginx :80/:443 public), vd 127.0.0.1:8080
GATEWAY_HOST_PORT=8080
IAM_HOST_PORT=4001
WORKFLOW_HOST_PORT=4002
AUTHENTIK_HTTP_PORT=19000
AUTHENTIK_HTTPS_PORT=19443

# ---- core ----
POSTGRES_DB=synapsedx
POSTGRES_USER=synapsedx
POSTGRES_PASSWORD=synapsedx_password_change_me
# compose tu dung DATABASE_URL/REDIS_URL tu cac phan tren; 2 dong duoi chi dung khi chay service ngoai docker:
# DATABASE_URL=postgres://synapsedx:synapsedx_password_change_me@localhost:5432/synapsedx
# REDIS_URL=redis://localhost:6379
REDIS_URL=redis://redis:6379

# ---- iam-service ----
IAM_JWT_SECRET=change_me_super_secret_32chars_min
IAM_JWT_EXPIRES_IN=3600
IAM_REFRESH_EXPIRES_IN=2592000
# Pepper for API-key / refresh-token hashes at rest (HMAC-SHA256). Empty = plain
# SHA-256 (dev default). PRODUCTION: set a random 32+ char value; old keys created
# before the pepper was set keep working (legacy fallback on verify).
IAM_API_KEY_PEPPER=
# Audit retention (days): hourly purge of audit_log rows older than N days.
# 0 = disabled (default, zero behavior change). Production: e.g. 180.
AUDIT_RETENTION_DAYS=0
# PROD: false (chi con OIDC/API key)
IAM_ALLOW_DEV_LOGIN=true
# Demo OIDC callback trusts caller-supplied email (impersonation possible).
# Dev default true. PRODUCTION: set false (endpoint then requires a real IdP `code`).
IAM_ALLOW_OIDC_DEMO_CALLBACK=true
# OIDC upstream (Authentik mac dinh, co the doi sang Keycloak)
OIDC_PROVIDER=authentik
OIDC_ISSUER=http://authentik-server:9000/application/o/synapsedx/
OIDC_CLIENT_ID=synapsedx-platform
OIDC_CLIENT_SECRET=change_me_oidc_secret
# Optional allowlist of org slugs allowed through OIDC (comma-separated).
# Empty = any slug may federate; a NEW slug is then self-service, while joining
# an EXISTING org always requires an existing membership. Set it in production
# to pin federation to your own org(s).
OIDC_ALLOWED_ORGS=
# HMAC key rieng cho OIDC state (chong CSRF). PROD: random 32+ ky tu (khac JWT secret).
# De trong = fallback IAM_JWT_SECRET (dev default).
OIDC_STATE_SECRET=
# PROD: the Console page that completes the SSO round-trip, e.g.
# https://cloud.synapsedx.sbs/oidc/callback (via gateway). The page POSTs the
# single-use code to the API — never use a bare API URL users can't reach.
OIDC_REDIRECT_URI=http://localhost:3000/oidc/callback

# ---- gateway ----
# NOTE: gateway rate limiting da go (quyet dinh van hanh) — rate-limit o
# Ingress/WAF/reverse proxy. Muon bat lai: revert commit go limiter.
GATEWAY_PORT=8080
GATEWAY_ROUTES_PATH=./routes.yaml
IAM_SERVICE_URL=http://iam:4001
WORKFLOW_SERVICE_URL=http://workflow:4002
# PROD: true (verify tap trung, fail-closed). Default true tu 0.3.2 (fail-closed);
# chi dat false khi dev cuc bo + hieu rui ro (bat ky X-API-Key nao cung qua).
GATEWAY_VERIFY_APIKEY=true
PROXY_TIMEOUT_MS=30000
# PROD: https://cloud.synapsedx.sbs,https://synapsedx.sbs
CORS_ORIGIN=
# Shared service-to-service credential (gateway -> iam + workflow + ai). Empty = dev
# mode (services warn at startup). PRODUCTION: set random 32+ chars on ALL FOUR
# services (same value) and do not publish internal host ports.
SYNAPSEDX_INTERNAL_SECRET=
# Send Strict-Transport-Security. Only enable behind TLS (docker-compose.tls.yml).
# PROD: true
HSTS_ENABLED=false

# ---- workflow-service (local built-in engine, no external dependency) ----
# Cron scheduler tick (ms): how often active cron workflows are checked.
WORKFLOW_CRON_TICK_MS=15000

# ---- object storage S3-compatible (S3Mock mac dinh; prod co the doi sang MinIO/S3 that) ----
S3_ENDPOINT=http://s3:9090
S3_BUCKET=synapsedx-core
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_HOST_PORT=9090

# ---- authentik (IdP; dot nay noi bo, public sau khi wired OIDC code-exchange that) ----
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authentik_pw_change_me
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_SECRET_KEY=change_me_authentik_secret_key_60chars_min_xxxxxxxxxxxxxxxx
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# ---- monitoring (Prometheus) ----
# Dev: mo http://localhost:9091 (Prometheus graph/alerts UI).
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml),
# truy cap bang port-forward/SSH tunnel.
PROMETHEUS_HOST_PORT=9091

# ---- sdk / demo ----
DEMO_ORG_SLUG=acme
DEMO_ACCOUNT_SLUG=prod

# ---- ai-service (agent hỗ trợ test API trên Console → API Docs) ----
# OpenAI-compatible provider (OpenRouter mặc định). Key ở SERVER-SIDE,
# không bao giờ xuống browser.
AI_SERVICE_HOST_PORT=127.0.0.1:4003
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=change_me_openrouter_api_key
AI_DECISION_MODEL=inception/mercury-2.5
AI_LLM_MODEL=apodex/apodex-1.1-mini:free
# Fallback model (different provider = uncorrelated outages) for generate/guide
# after the primary exhausts retries. Default = decision model. Empty disables.
AI_LLM_FALLBACK_MODEL=inception/mercury-2.5
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT=30
AI_RETRIES=2

# ---- lds-service (SynapseLDS — linked data / NGSI-LD exports) ----
# PROD: unpublish port qua overlay (xem docker-compose.prod.yml).
LDS_SERVICE_HOST_PORT=127.0.0.1:4004
