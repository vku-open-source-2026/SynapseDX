  "private": true,
  "license": "Apache-2.0",
  "description": "SynapseDX Tier-2 capability control plane console",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:routes": "tsr generate",
    "build": "tsr generate && tsc -b && vite build",
