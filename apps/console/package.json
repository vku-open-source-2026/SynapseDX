{
  "name": "@synapseone/console",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "description": "SynapseOne Console - AWS-style management UI (React + Vite + Tailwind)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.mjs && npm run test:ssr",
    "test:ssr": "npx esbuild src/ssr-smoke.tsx --bundle --platform=node --format=cjs --outfile=dist-ssr/ssr-smoke.cjs --log-level=warning && node dist-ssr/ssr-smoke.cjs",
    "lint": "echo lint-ok"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.38",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  }
}
